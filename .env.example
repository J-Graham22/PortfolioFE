# Path to the SQLite database file
DATABASE_URL=local.db
# Where uploaded images are stored
UPLOAD_DIR=uploads

# Bearer token for every write to /api/* (generate with: openssl rand -base64 32)
ADMIN_API_TOKEN=
# Used by `npm run post` and `npm run db:seed` to find the site
SITE_URL=http://localhost:5173

# Spotify "now playing" (see scripts/spotify-auth.ts)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Hardcover "currently reading": https://hardcover.app/account/api
HARDCOVER_API_TOKEN=
